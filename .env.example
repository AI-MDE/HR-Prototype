# Every port the project uses. Change them here, never in source or tool configuration.
# The Workbench (mde workbench) for this project
MDE_WORKBENCH_PORT=3091
# The web pages (the frontend's server)
WEB_PORT=5173
# The API (the backend's server)
API_PORT=3000
# Where the pages get their data: api (the application's own backend) or runtime (the MDE runtime, a prototype only)
SERVER_SOURCE=api
# The backend's path prefix, proxied to API_PORT
API_BASE=/api
